# Astronomer / Astro Runtime (primary local development path)
ASTRO_RUNTIME_VERSION=3.3-2
OLIST_PROJECT_ROOT=/usr/local/airflow
DBT_PROJECT_DIR=/usr/local/airflow/dbt
DBT_PROFILES_DIR=/usr/local/airflow/dbt
OLIST_SCRIPT_DIR=/usr/local/airflow/scripts
OLIST_DATA_DIR=/usr/local/airflow/data/raw

# Apache Airflow fallback through docker-compose.yml
AIRFLOW_VERSION=3.3.1
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=replace-with-a-long-random-string

# Snowflake account identifier, for example: xy12345.eu-central-1
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=OLIST_WH
SNOWFLAKE_DATABASE=OLIST_DWH
SNOWFLAKE_BRONZE_SCHEMA=BRONZE
SNOWFLAKE_SILVER_SCHEMA=SILVER
SNOWFLAKE_GOLD_SCHEMA=GOLD

# true: the loader creates an X-Small warehouse and database when they are absent.
# false: warehouse and database must already exist and be accessible to the role.
SNOWFLAKE_CREATE_RESOURCES=true
SNOWFLAKE_WAREHOUSE_SIZE=XSMALL

DBT_THREADS=4

# Empty means manual runs only. Example daily schedule: 0 5 * * *
OLIST_DAG_SCHEDULE=
